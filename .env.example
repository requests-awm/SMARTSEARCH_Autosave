# --- Asana ---
ASANA_PAT=
ASANA_WORKSPACE_GID=666438144056
ASANA_PROJECT_GID=1211423560008759
ASANA_SECTION_GID=1211963770737272
# Custom field that receives the Google Drive link
ASANA_URL_FIELD_GID=1211976904388076
# Comma-separated names of the custom fields that must be filled before processing
# (matched case-insensitively, partial names OK)
REQUIRED_FIELD_NAMES=SmartSearch Expiry Date
EXPIRY_FIELD_NAME=SmartSearch Expiry Date

# --- Insightly ---
INSIGHTLY_API_KEY=
INSIGHTLY_API_URL=https://api.na1.insightly.com/v3.1
INSIGHTLY_URL_FIELD=SmartSearch_URL__c
INSIGHTLY_EXPIRY_FIELD=SmartSearch_Expiry_Date__c

# --- Google Drive (option A: service account with access to the shared drive) ---
GOOGLE_SERVICE_ACCOUNT_FILE=
# --- Google Drive (option B: OAuth refresh token) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

GDRIVE_SHARED_DRIVE_ID=0AI3XFY5Ifk7VUk9PVA
GDRIVE_FOLDER_TEMPLATE=A - Anti-Money Laundering - {CONTACT_ID} - DUAL

PORT=3000

# --- SSO (enforced by default; server refuses to start without the secret) ---
SSO_SHARED_SECRET=
SSO_AUD=clientsignup.ascotwm.com
# Set to false ONLY to explicitly run without authentication (local dev)
SSO_ENFORCED=true
# Set to true when served over HTTPS (adds Secure flag to the SSO cookie)
COOKIE_SECURE=false
